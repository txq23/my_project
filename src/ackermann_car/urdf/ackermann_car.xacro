<?xml version="1.0"?>
<robot name="ackermann_car" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- base -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.3 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.6 0.3 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.02"/>
        </geometry>
        <origin xyz="${x} ${y} 0.025" rpy="1.57 0 0"/>
        <material name="black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} 0.025"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel"  x="0.2"  y="0.15"/>
  <xacro:wheel name="front_right_wheel" x="0.2"  y="-0.15"/>
  <xacro:wheel name="rear_left_wheel"   x="-0.2" y="0.15"/>
  <xacro:wheel name="rear_right_wheel"  x="-0.2" y="-0.15"/>

</robot>
