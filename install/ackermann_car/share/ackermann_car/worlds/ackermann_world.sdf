    <model name="box">
      <pose>0 -2 0.1 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>3</mass>
          <inertia>
            <ixx>0.05</ixx>
            <iyy>0.05</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 0.4 0.4</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.3</mu>
                <mu2>0.3</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 0.4 0.4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.6 0.6 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin name="box_planar_move" filename="libgazebo_ros_planar_move.so">
        <ros>
          <namespace>/box</namespace>
          <remapping>cmd_vel:=/box_cmd</remapping>
          <remapping>odom:=/box/odom</remapping>
        </ros>
        <update_rate>50</update_rate>
        <inertia>0.05</inertia>
        <max_force>20</max_force>
      </plugin>
    </model>

  </world>
</sdf>