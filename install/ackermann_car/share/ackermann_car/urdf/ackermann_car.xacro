<?xml version="1.0"?>
<robot name="ackermann_car" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 材质定义 -->
  <material name="blue"><color rgba="0.0 0.3 1.0 1.0"/></material>
  <material name="black"><color rgba="0.0 0.0 0.0 1.0"/></material>
  <material name="steel"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="dark_gray"><color rgba="0.2 0.2 0.2 1.0"/></material>

  <!-- 主体底盘 -->
  <link name="chassis">
    <visual><geometry><box size="1.2 0.6 0.2"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="1.2 0.6 0.2"/></geometry></collision>
    <inertial><mass value="20.0"/><inertia ixx="0.6667" ixy="0" ixz="0" iyy="2.4667" iyz="0" izz="3.0"/></inertial>
  </link>

  <!-- imu_link -->
  <link name="imu_link">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="dark_gray"/></visual>
    <collision><geometry><box size="0.05 0.05 0.05"/></geometry></collision>
    <inertial><mass value="0.01"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- lidar_link -->
  <link name="lidar_link">
    <visual><geometry><cylinder length="0.1" radius="0.05"/></geometry><origin rpy="1.5708 0 0"/><material name="dark_gray"/></visual>
    <collision><geometry><cylinder length="0.1" radius="0.05"/></geometry><origin rpy="1.5708 0 0"/></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0.5 0 0.3" rpy="0 0 0"/>
  </joint>

  <!-- camera_link -->
  <link name="camera_link">
    <visual><geometry><box size="0.1 0.05 0.05"/></geometry><material name="dark_gray"/></visual>
    <collision><geometry><box size="0.1 0.05 0.05"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.4 0 0.2" rpy="0 0.2 0"/>
  </joint>

  <!-- 转向杆与前轮 -->
  <link name="front_left_steer_link">
    <visual><geometry><cylinder length="0.05" radius="0.03"/></geometry><material name="steel"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.03"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="chassis"/>
    <child link="front_left_steer_link"/>
    <origin xyz="0.5 0.25 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1.0"/>
  </joint>

  <link name="front_left_wheel">
    <visual><geometry><cylinder length="0.05" radius="0.15"/></geometry><origin rpy="1.5708 0 0"/><material name="black"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.15"/></geometry><origin rpy="1.5708 0 0"/></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.0117" iyy="0.0225" izz="0.0117" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- front right -->
  <link name="front_right_steer_link">
    <visual><geometry><cylinder length="0.05" radius="0.03"/></geometry><material name="steel"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.03"/></geometry></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="chassis"/>
    <child link="front_right_steer_link"/>
    <origin xyz="0.5 -0.25 -0.15" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1.0"/>
  </joint>

  <link name="front_right_wheel">
    <visual><geometry><cylinder length="0.05" radius="0.15"/></geometry><origin rpy="1.5708 0 0"/><material name="black"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.15"/></geometry><origin rpy="1.5708 0 0"/></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.0117" iyy="0.0225" izz="0.0117" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- rear left -->
  <link name="rear_left_wheel">
    <visual><geometry><cylinder length="0.05" radius="0.15"/></geometry><origin rpy="1.5708 0 0"/><material name="black"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.15"/></geometry><origin rpy="1.5708 0 0"/></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.0117" iyy="0.0225" izz="0.0117" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.5 0.25 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- rear right -->
  <link name="rear_right_wheel">
    <visual><geometry><cylinder length="0.05" radius="0.15"/></geometry><origin rpy="1.5708 0 0"/><material name="black"/></visual>
    <collision><geometry><cylinder length="0.05" radius="0.15"/></geometry><origin rpy="1.5708 0 0"/></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.0117" iyy="0.0225" izz="0.0117" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.5 -0.25 -0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
